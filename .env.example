# ─────────────────────────────────────────────────────────────────────────────
# .env.example — template za lokalni .env fajl
#
# Kopiraj ovaj fajl u .env i popuni vrednosti:
#   cp .env.example .env
#
# .env je u .gitignore — nikad ga ne commituj!
# Svaki developer ima sopstveni .env sa lokalnim podesavanjima.
#
# Ove varijable koristi docker-compose.override.yml za portove i konfiguraciju.
# ─────────────────────────────────────────────────────────────────────────────

# Opciono: ako imas privatni Docker registry
DOCKER_REGISTRY=

# Identity API port na host masini
# Default: 5100 (http://localhost:5100/swagger)
IDENTITY_API_PORT=5100

# SQL Server port na host masini (za SSMS, Azure Data Studio, JetBrains DataGrip)
# Default: 1433 (standardni SQL Server port)
BA_DB_PORT=1433
