# Copy this file to .env (gitignored) and fill in real values.
# docker-compose reads .env automatically for ${VAR} substitution in docker-compose.override.yml.

# Azure Storage connection string used by business.api inside Docker — get it from
# `az storage account show-connection-string ...` (see README.md's Blob Storage & Secrets section).
BLOB_STORAGE_CONNECTION_STRING=

# Sentry DSN for the backend project (identity.api + business.api) — get it from
# Sentry → Settings → Projects → your backend project → Client Keys (DSN).
SENTRY_DSN=
