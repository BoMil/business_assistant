{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // JWT podesavanja — koristi ih Identity.Infrastructure.JwtProvider za generisanje tokena
  // i SetupInfrastructureLayer za validaciju tokena na svakom zahtevu.
  //
  // VAZNO: Jwt:Secret u produkciji NIKAD ne sme biti u ovom fajlu!
  // Treba da dodje iz Azure Key Vault, environment variable, ili User Secrets.
  // Ovde su placeholder vrednosti koje se overriduju u appsettings.Development.json.
  "Jwt": {
    "Secret": "CHANGE_ME_IN_PRODUCTION_USE_KEY_VAULT",
    "Issuer": "identity-api",
    "Audience": "business-assistant-clients",
    "ExpiryMinutes": "60"
  },

  // Connection string za SQL Server bazu Identity mikroservisa.
  // Format: "Server=<server>;Database=<db>;User Id=<user>;Password=<pass>;TrustServerCertificate=True"
  // U razvoju: appsettings.Development.json ga overriduje sa lokalnim SQL Server-om.
  "ConnectionStrings": {
    "IdentityDb": "CHANGE_ME_IN_PRODUCTION"
  },

  // Deljeni tajni kljuc za GET /tenants/{slug}/config — poziva ga samo CI/CD
  // pipeline (mobile-android.yml) da povuce tenant branding pre builda, ne
  // krajnji korisnik. VAZNO: u produkciji dolazi iz Azure Key Vault, isto kao Jwt:Secret.
  "CiApiKey": "CHANGE_ME_IN_PRODUCTION_USE_KEY_VAULT",

  // Azure Blob Storage connection string, koristi se za upload korisnickih slika (User.ImgUrl).
  // VAZNO: u produkciji dolazi iz Azure Key Vault, isto kao Jwt:Secret. Za lokalni razvoj: dotnet user-secrets.
  "BlobStorage": {
    "ConnectionString": "CHANGE_ME_IN_PRODUCTION_USE_KEY_VAULT"
  },

  // RabbitMQ — message bus koji Business koristi da objavi TenantNotificationRequested
  // (kad se kreira Event/Asset), a Identity ga konzumira i salje push. Videti README.md.
  "RabbitMq": {
    "Host": "CHANGE_ME_IN_PRODUCTION",
    "Username": "CHANGE_ME_IN_PRODUCTION_USE_KEY_VAULT",
    "Password": "CHANGE_ME_IN_PRODUCTION_USE_KEY_VAULT"
  }
}
