{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // JWT podesavanja — koristi ih Identity.Infrastructure.JwtProvider za generisanje tokena
  // i SetupInfrastructureLayer za validaciju tokena na svakom zahtevu.
  //
  // VAZNO: Jwt:Secret u produkciji NIKAD ne sme biti u ovom fajlu!
  // Treba da dodje iz Azure Key Vault, environment variable, ili User Secrets.
  // Ovde su placeholder vrednosti koje se overriduju u appsettings.Development.json.
  "Jwt": {
    "Secret": "CHANGE_ME_IN_PRODUCTION_USE_KEY_VAULT",
    "Issuer": "identity-api",
    "Audience": "business-assistant-clients",
    "ExpiryMinutes": "60"
  },

  // Connection string za SQL Server bazu Identity mikroservisa.
  // Format: "Server=<server>;Database=<db>;User Id=<user>;Password=<pass>;TrustServerCertificate=True"
  // U razvoju: appsettings.Development.json ga overriduje sa lokalnim SQL Server-om.
  "ConnectionStrings": {
    "IdentityDb": "CHANGE_ME_IN_PRODUCTION"
  }
}
