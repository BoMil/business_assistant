{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // Rute + klasteri za YARP. Path prefiks odredjuje ka kom mikroservisu se
  // zahtev prosledjuje — mobilna/web aplikacija zna samo za Gateway-jevu
  // adresu, ne i za pojedinacne servise iza njega.
  //
  // Destinations adrese ovde su placeholder — overriduju se u
  // appsettings.Development.json (pokretanje servisa direktno na hostu)
  // ili u docker-compose.override.yml (pokretanje kroz kontejnere).
  "ReverseProxy": {
    "Routes": {
      "identityRoute": {
        "ClusterId": "identityCluster",
        "Match": {
          "Path": "/identity/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/identity" }
        ]
      },
      "businessRoute": {
        "ClusterId": "businessCluster",
        "Match": {
          "Path": "/business/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/business" }
        ]
      }
    },
    "Clusters": {
      "identityCluster": {
        "Destinations": {
          "destination1": {
            "Address": "CHANGE_ME_IN_PRODUCTION"
          }
        }
      },
      "businessCluster": {
        "Destinations": {
          "destination1": {
            "Address": "CHANGE_ME_IN_PRODUCTION"
          }
        }
      }
    }
  }
}
